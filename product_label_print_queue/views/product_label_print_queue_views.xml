<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_label_print_queue_view_list" model="ir.ui.view">
        <field name="name">product.label.print.queue.list</field>
        <field name="model">product.label.print.queue</field>
        <field name="arch" type="xml">
            <list string="Labels to print" create="0" edit="0">
                <header>
                    <button name="action_print_labels" type="object" string="Print Labels" class="btn-primary"/>
                    <button name="action_dismiss" type="object" string="Remove"/>
                </header>
                <field name="create_date" string="Changed on"/>
                <field name="product_tmpl_id"/>
                <field name="source"/>
                <field name="pricelist_id" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="old_price" widget="monetary"/>
                <field name="new_price" widget="monetary"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="state" widget="badge"
                    decoration-warning="state == 'pending'"
                    decoration-success="state == 'printed'"
                    decoration-muted="state == 'cancelled'"/>
                <button name="action_dismiss" type="object" icon="fa-times" title="Remove"
                    invisible="state != 'pending'"/>
            </list>
        </field>
    </record>

    <record id="product_label_print_queue_view_form" model="ir.ui.view">
        <field name="name">product.label.print.queue.form</field>
        <field name="model">product.label.print.queue</field>
        <field name="arch" type="xml">
            <form string="Labels to print" create="0" edit="0">
                <header>
                    <button name="action_print_labels" type="object" string="Print Labels" class="btn-primary"
                        invisible="state != 'pending'"/>
                    <button name="action_dismiss" type="object" string="Remove"
                        invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,printed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="product_tmpl_id"/>
                            <field name="source"/>
                            <field name="pricelist_id"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="old_price" widget="monetary"/>
                            <field name="new_price" widget="monetary"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_label_print_queue_view_search" model="ir.ui.view">
        <field name="name">product.label.print.queue.search</field>
        <field name="model">product.label.print.queue</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_tmpl_id"/>
                <field name="pricelist_id"/>
                <field name="user_id"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="printed" string="Printed" domain="[('state', '=', 'printed')]"/>
                <filter name="cancelled" string="Removed" domain="[('state', '=', 'cancelled')]"/>
                <group>
                    <filter name="group_source" string="Source" context="{'group_by': 'source'}"/>
                    <filter name="group_pricelist" string="Pricelist" context="{'group_by': 'pricelist_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_product_label_print_queue" model="ir.actions.act_window">
        <field name="name">Labels to print</field>
        <field name="res_model">product.label.print.queue</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No label is waiting to be printed.</p>
            <p>A product is added here when its sales price, variant extra price, or pricelist rule changes.</p>
        </field>
    </record>
</odoo>
